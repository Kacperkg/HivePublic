# Docker Compose development values only. Never use these credentials in production.
POSTGRES_DB=the_hive
POSTGRES_USER=the_hive
POSTGRES_PASSWORD=development-only-password
POSTGRES_PORT=5433
DATABASE_URL=postgres://the_hive:development-only-password@postgres:5432/the_hive?sslmode=disable
BACKEND_PORT=8080
METRO_PORT=8081
SESSION_TTL_HOURS=720
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
